# Server
NODE_ENV=development
PORT=4000
# Long random string. Required in production (32+ chars).
JWT_SECRET=
JWT_TTL=12h
# Comma separated. "*.vercel.app" style wildcards are allowed.
CORS_ORIGINS=http://localhost:5173
# Public URL of this API (used for local file links) and of the frontend (used in invite and share links)
PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:5173
INVITE_TTL_HOURS=72
REPORT_TZ=Asia/Kolkata

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_uat

# Screenshot storage: local (dev) or s3 (prod, any S3 compatible store)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=ap-south-1
# Leave empty for AWS. Set for R2, MinIO and similar.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_TTL_SECONDS=900

# First admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Branding used in reports
BRAND_COMPANY=VAICS Consulting
BRAND_PRIMARY=#1F3864

# Hub Portal SSO (not active yet)
AUTH_HUB_SSO_ENABLED=false

# Tests only
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_uat_test
